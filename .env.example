# Copier ce fichier en « .env » (jamais commité) puis compléter.
# docker compose lit automatiquement le fichier .env du dossier.

# --- Envoi des e-mails (Gmail : https://myaccount.google.com/apppasswords) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=votre.adresse@gmail.com
# Mot de passe d'application Gmail (16 lettres), PAS le mot de passe du compte
SMTP_PASSWORD=
SMTP_FROM=votre.adresse@gmail.com
SMTP_FROM_NAME=Cotisen

# --- Application ---
# Port sur la machine (8080 par défaut ; 8088 si 8080 est déjà pris)
APP_PORT=8088
# Adresse publique utilisée dans les liens des e-mails
APP_BASE_URL=http://localhost:8088
